# Réécriture d'URL : toutes les requêtes vers un fichier ou dossier inexistant passent par index.php
# Exemple : /parfums/12-sauvage  =>  index.php?url=parfums/12-sauvage
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Pas de liste de fichiers dans les dossiers
Options -Indexes
